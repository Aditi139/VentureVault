# VentureVault Environment Variables Configuration
# Copy this file to .env and adjust variables as needed

# Django Secret Key (Generate a random string for production)
DJANGO_SECRET_KEY=your-production-secret-key-change-this-in-production

# Debug Mode: True for development, False for production
DJANGO_DEBUG=True

# Allowed Hosts: comma-separated list of hostnames/IPs
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

